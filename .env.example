# Surakshaa Saathi — Environment Configuration Example

# Server Configuration
PORT=5000
SECRET_KEY=your-secure-random-secret-key-surakshaa-2026

# AI Model Configuration (Optional)
# If provided, the chatbot leverages OpenAI or compatible Responses API.
# If omitted, the built-in intelligent Cyber Safety Reasoning Core automatically handles all queries seamlessly.
OPENAI_API_KEY=

# Transactional Email Delivery (Optional)
# Configure SMTP credentials if automatic email delivery of certificates is enabled.
# If omitted, certificates remain 100% available for instant direct PDF/PNG downloads on the portal.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=cert-verify@surakshaasaathi.in

